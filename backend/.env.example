# Native local-development defaults.
#
# Copy this file to backend/.env only when using the supported native runtime:
# CPython 3.11 or 3.12 on Linux glibc x86_64 or aarch64, with libseccomp.so.2
# and /proc available. The Docker workflow supplies equivalent
# container-network values and does not require this file.

WORKSTREAM_ENVIRONMENT=local
WORKSTREAM_DEBUG=true
WORKSTREAM_DATABASE_URL=postgresql+asyncpg://workstream:workstream@localhost:5433/workstream

# Development auth is local-only. These values grant identity, not Workstream
# product authority; bootstrap grants separately when an endpoint requires it.
WORKSTREAM_AUTH_PROVIDER=dev
WORKSTREAM_DEV_AUTH_TOKEN=workstream-local-dev-token
WORKSTREAM_DEV_AUTH_SUBJECT=local-developer
WORKSTREAM_DEV_AUTH_ISSUER=https://workstream.local/development

# Deterministic local-only 32-byte base64 keys. Replace them when testing key
# rotation. Never reuse these public example values outside local development.
WORKSTREAM_API_RATE_LIMIT_KEY_SECRET=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
WORKSTREAM_PAGINATION_CURSOR_HMAC_SECRET=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

WORKSTREAM_CELERY_BROKER_URL=redis://localhost:6379/0

# Diagnostics are always privacy-bounded locally; export is opt-in. Set only a
# credential-free collector origin here. Supply collector authentication through
# the deployment secret environment (for example OTEL_EXPORTER_OTLP_HEADERS),
# never this committed example file.
WORKSTREAM_OBSERVABILITY_LOG_LEVEL=INFO
# WORKSTREAM_OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4318
WORKSTREAM_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
WORKSTREAM_OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=2.0
WORKSTREAM_OBSERVABILITY_SHUTDOWN_TIMEOUT_SECONDS=3.0

# Compose host ports; keep the URLs above aligned when changing these.
WORKSTREAM_POSTGRES_HOST_PORT=5433
WORKSTREAM_REDIS_HOST_PORT=6379

# The quickstart keeps artifact storage disabled. Integration tests configure
# repository-managed MinIO explicitly when they need the S3-compatible path.
WORKSTREAM_ARTIFACT_STORE_BACKEND=disabled

# Unified guide setup uses the same runtime/result contract with explicit provider
# selection. Install the locked runtime: uv sync --locked --extra dev --extra agents.
# Run connected setup through Docker Compose (backend profile): the worker alone
# receives the model key and a socket to the isolated, networkless document parser.
# Native API-only development needs no provider key. See developer-setup.md.
# Keep real keys only in ignored env files or deployment secrets.
WORKSTREAM_PROJECT_AGENT_RUNTIME=openai_agents_sdk
WORKSTREAM_PROJECT_AGENT_MODEL_PROVIDER=openrouter
WORKSTREAM_PROJECT_AGENT_MODEL_API=chat_completions
WORKSTREAM_PROJECT_AGENT_MODEL=openai/gpt-5.6-terra
# OPENROUTER_API_KEY=your-private-api-key
# For OpenAI directly, select provider=openai and its model ID and OPENAI_API_KEY.
# There is no automatic provider fallback.
# Native timeout/retry controls belong to the selected adapter. Empty options use
# its validated defaults (OpenAI Agents SDK: 300s/request, at most two safe retries).
WORKSTREAM_PROJECT_AGENT_RUNTIME_OPTIONS={}
# Example override: {"request_timeout_seconds":300,"maximum_retries":2}
WORKSTREAM_PROJECT_AGENT_RUN_TIMEOUT_SECONDS=1800
WORKSTREAM_PROJECT_AGENT_MAX_MANIFEST_BYTES=256000
WORKSTREAM_PROJECT_AGENT_MAX_DOCUMENTS=100
WORKSTREAM_PROJECT_AGENT_MAX_DOCUMENT_BYTES=67108864
WORKSTREAM_PROJECT_AGENT_MAX_TOTAL_DOCUMENT_BYTES=536870912
WORKSTREAM_PROJECT_AGENT_MAX_TURNS=40
WORKSTREAM_PROJECT_AGENT_MAX_TOOL_CALLS=80
WORKSTREAM_PROJECT_AGENT_MAX_TOOL_OUTPUT_CHARACTERS=4194304
WORKSTREAM_GUIDE_DOCUMENT_PARSER_SOCKET=/var/lib/workstream/guide-runtime/guide.sock
# Provider-free alternative: a manager-uploaded rules document, same trusted tools.
# Set runtime=manager_authored, provider/model/API=none, runtime options={} together.
# Omit these to use the trusted instructions shipped with Workstream.
# WORKSTREAM_PROJECT_AGENT_INSTRUCTIONS="Your complete trusted setup instructions."
# WORKSTREAM_PROJECT_AGENT_INSTRUCTION_VERSION=your-instruction-revision

# Connected guide testing also needs original-document storage. Replace the
# disabled backend above with s3_compatible and configure an existing local MinIO
# bucket using these settings. These public credentials match local Compose only.
# WORKSTREAM_ARTIFACT_S3_PROVIDER_PROFILE=minio
# WORKSTREAM_ARTIFACT_S3_REGION=us-east-1
# WORKSTREAM_ARTIFACT_S3_ENDPOINT_URL=http://localhost:9000
# WORKSTREAM_ARTIFACT_S3_BUCKET=workstream-artifacts
# WORKSTREAM_ARTIFACT_S3_PRIVATE_PREFIX=workstream/artifacts
# WORKSTREAM_ARTIFACT_S3_ADDRESSING_STYLE=path
# WORKSTREAM_ARTIFACT_S3_CREDENTIAL_MODE=local_static
# WORKSTREAM_ARTIFACT_S3_ACCESS_KEY_ID=workstream-minio
# WORKSTREAM_ARTIFACT_S3_SECRET_ACCESS_KEY=workstream-minio-secret-key
# Native AWS activation uses non-secret exact deployment identities. These values
# identify the environment to prove; none of them asserts that proof passed.
# WORKSTREAM_RELEASE_ID=sha256:<64-lowercase-hex>
# WORKSTREAM_ARTIFACT_S3_RUNTIME_ROLE_ARN=arn:aws:iam::<account>:role/<runtime-role>
# WORKSTREAM_ARTIFACT_S3_RUNTIME_TRUST_POLICY_SHA256=sha256:<64-lowercase-hex>
# WORKSTREAM_ARTIFACT_S3_RUNTIME_POLICY_ARN=arn:aws:iam::<account>:policy/<runtime-policy>
# WORKSTREAM_ARTIFACT_S3_READINESS_ROLE_ARN=arn:aws:iam::<account>:role/<readiness-role>
# WORKSTREAM_ARTIFACT_S3_READINESS_TRUST_POLICY_SHA256=sha256:<64-lowercase-hex>
# WORKSTREAM_ARTIFACT_S3_READINESS_POLICY_ARN=arn:aws:iam::<account>:policy/<readiness-policy>
# WORKSTREAM_ARTIFACT_S3_NEGATIVE_ROLE_ARN=arn:aws:iam::<account>:role/<negative-role>
# WORKSTREAM_ARTIFACT_S3_NEGATIVE_TRUST_POLICY_SHA256=sha256:<64-lowercase-hex>
# WORKSTREAM_ARTIFACT_S3_BOOTSTRAP_PRINCIPAL_ARN=arn:aws:iam::<account>:role/<bootstrap-role>
# WORKSTREAM_ARTIFACT_S3_BUCKET_POLICY_SHA256=sha256:<64-lowercase-hex>
# External Linux hosts use the same native AWS adapter with the explicitly
# selected Roles Anywhere provider. The hosted release image pins the official
# helper at /usr/local/bin/aws_signing_helper. Use the configuration generator
# and AWS read-resource JSON described in docs/operations_aws_roles_anywhere.md;
# do not compute the anchor/profile digests by hand or configure SDK profiles.
# WORKSTREAM_ARTIFACT_S3_AWS_WORKLOAD_IDENTITY_METHOD=roles-anywhere
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:<region>:<account>:trust-anchor/<id>
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_TRUST_ANCHOR_SHA256=sha256:<generated>
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:<region>:<account>:profile/<id>
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_PROFILE_SHA256=sha256:<generated>
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_ROLE_ARN=arn:aws:iam::<account>:role/<selected-role>
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_CERTIFICATE_FILE=/absolute/private/leaf-certificate.pem
# WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_PRIVATE_KEY_FILE=/absolute/private/leaf-private-key.pem

# Required when enabling artifact storage: explicit local capacity and scratch.
# WORKSTREAM_ARTIFACT_ADMISSION_TASK_MAXIMUM_BYTES=67108864
# WORKSTREAM_ARTIFACT_ADMISSION_PRODUCER_MAXIMUM_BYTES=268435456
# WORKSTREAM_ARTIFACT_ADMISSION_PROJECT_MAXIMUM_BYTES=1073741824
# WORKSTREAM_ARTIFACT_ADMISSION_DEPLOYMENT_MAXIMUM_BYTES=4294967296
# WORKSTREAM_ARTIFACT_SCRATCH_ROOT=/tmp/workstream-local-artifact-scratch

# Required for contributor ZIP intake and durable post-submission materialization.
# Provision the pinned trusted image on a Smol node; see external_checkers/README.md.
# WORKSTREAM_ARTIFACT_INTAKE_SERVICE_SOCKET=/absolute/private/checker.sock
# WORKSTREAM_ARTIFACT_INTAKE_IMAGE_DIGEST=sha256:<64-lowercase-hex>
# WORKSTREAM_ARTIFACT_INTAKE_CONFIG_DIGEST=sha256:<64-lowercase-hex>
