{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstream.local/schemas/internal-review-receipt-v3.json",
  "title": "Workstream Internal Review Receipt",
  "x-proof-custody-matrix": {
    "pure": {"proof_strength": "pure", "kind": "executed", "required_observations": ["pure_result"]},
    "service": {"proof_strength": "service", "kind": "executed", "required_observations": ["service_orchestration"]},
    "repository": {"proof_strength": "repository", "kind": "executed", "required_observations": ["stored_row"]},
    "repository_isolation": {"proof_strength": "repository", "kind": "executed", "required_observations": ["stored_row", "stored_foreign_resource"]},
    "transaction": {"proof_strength": "transaction", "kind": "executed", "required_observations": ["staged_state", "final_state"]},
    "concurrency": {"proof_strength": "concurrency", "kind": "executed", "required_observations": ["independent_sessions"]},
    "direct_sql": {"proof_strength": "direct_sql", "kind": "executed", "required_observations": ["orm_bypassed"]},
    "composition": {"proof_strength": "composition", "kind": "executed", "required_observations": ["composition_root"]},
    "negative_structure": {"proof_strength": "negative_structure", "kind": "inspected", "required_observations": ["syntax_or_registry"]},
    "plan_contract": {"proof_strength": "contract_inspection", "kind": "inspected", "required_observations": ["contract_counterexample"]},
    "document_consistency": {"proof_strength": "contract_inspection", "kind": "inspected", "required_observations": ["source_comparison"]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "custody", "target", "reviewer", "inspections", "evidence", "impact_cone", "adversarial_probes", "traceability", "residual_escape", "findings", "uncertainty", "freshness", "verdict"],
  "properties": {
    "schema_version": {"const": 3},
    "custody": {"const": "advisory_session"},
    "target": {"$ref": "#/$defs/target"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialty", "run_id"],
      "properties": {
        "specialty": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "inspections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/inspection"},
        "end": {"$ref": "#/$defs/inspection"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source", "result"],
        "properties": {
          "kind": {"enum": ["executed", "inspected"]},
          "source": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "unavailable"]}
        }
      }
    },
    "impact_cone": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "relevance"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "relevance": {"type": "string", "minLength": 1}
        }
      }
    },
    "adversarial_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis", "method", "defect", "expected_observation", "actual_observation", "proof_survived", "result"],
        "properties": {
          "hypothesis": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "defect": {"type": "string", "minLength": 1},
          "expected_observation": {"type": "string", "minLength": 1},
          "actual_observation": {"type": "string", "minLength": 1},
          "proof_survived": {"type": "boolean"},
          "result": {"enum": ["pass", "fail", "unavailable"]}
        }
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "behavior", "owner", "implementation_source", "proof_source", "execution_custody", "claimed_boundary", "proof_strength", "proof_custody", "proof_compatibility", "result"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "behavior": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "implementation_source": {"type": "string", "minLength": 1},
          "proof_source": {"type": "string", "minLength": 1},
          "execution_custody": {"type": "string", "minLength": 1},
          "claimed_boundary": {"$ref": "#/$defs/claimed_boundary"},
          "proof_strength": {"$ref": "#/$defs/proof_strength"},
          "proof_custody": {"$ref": "#/$defs/proof_custody"},
          "proof_compatibility": {"enum": ["compatible", "incompatible", "unavailable"]},
          "result": {"enum": ["verified", "missing", "unavailable"]}
        }
      }
    },
    "residual_escape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "method", "result"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "result": {"enum": ["falsified", "survives", "unavailable"]}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "freshness": {"enum": ["current", "stale"]},
    "verdict": {"enum": ["PASS", "PASS AFTER FIXES", "PASS WITH LOW RISKS", "N/A - with approved reason", "PROVISIONAL", "BLOCKED"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "findings": {
            "contains": {
              "type": "object",
              "required": ["blocks_pr", "disposition"],
              "properties": {
                "blocks_pr": {"const": true},
                "disposition": {"const": "unresolved"}
              }
            }
          }
        }
      },
      "then": {"properties": {"verdict": {"enum": ["PROVISIONAL", "BLOCKED"]}}}
    },
    {
      "if": {"properties": {"verdict": {"enum": ["PASS", "PASS AFTER FIXES", "PASS WITH LOW RISKS"]}}},
      "then": {
        "properties": {
          "freshness": {"const": "current"},
          "inspections": {
            "properties": {
              "start": {"properties": {"cleanliness": {"const": "clean"}}},
              "end": {"properties": {"cleanliness": {"const": "clean"}}}
            }
          },
          "adversarial_probes": {
            "contains": {
              "type": "object",
              "required": ["proof_survived", "result"],
              "properties": {
                "proof_survived": {"const": false},
                "result": {"const": "pass"}
              }
            },
            "minContains": 1,
            "not": {
              "contains": {
                "type": "object",
                "required": ["proof_survived"],
                "properties": {"proof_survived": {"const": true}}
              }
            }
          },
          "traceability": {
            "items": {
              "type": "object",
              "required": ["proof_compatibility", "result"],
              "properties": {
                "proof_compatibility": {"const": "compatible"},
                "result": {"const": "verified"}
              }
            }
          },
          "residual_escape": {
            "properties": {"result": {"const": "falsified"}}
          },
          "findings": {
            "not": {
              "contains": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": ["severity", "disposition"],
                    "properties": {
                      "severity": {"enum": ["Critical", "High", "Medium"]},
                      "disposition": {"const": "unresolved"}
                    }
                  },
                  {
                    "type": "object",
                    "required": ["severity", "disposition"],
                    "properties": {
                      "severity": {"enum": ["Critical", "High"]},
                      "disposition": {"enum": ["accepted_risk", "deferred_with_owner"]}
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "proof_strength": {"enum": ["pure", "service", "repository", "transaction", "concurrency", "direct_sql", "composition", "negative_structure", "contract_inspection"]},
    "claimed_boundary": {"enum": ["pure", "service", "repository", "repository_isolation", "transaction", "concurrency", "direct_sql", "composition", "negative_structure", "plan_contract", "document_consistency"]},
    "proof_observation": {"enum": ["pure_result", "service_orchestration", "stored_row", "stored_foreign_resource", "staged_state", "final_state", "independent_sessions", "orm_bypassed", "composition_root", "syntax_or_registry", "contract_counterexample", "source_comparison"]},
    "proof_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observations"],
      "properties": {
        "kind": {"enum": ["executed", "inspected", "unavailable"]},
        "observations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/proof_observation"}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "merge_base_sha", "head_sha"],
      "properties": {
        "base_sha": {"$ref": "#/$defs/sha"},
        "merge_base_sha": {"$ref": "#/$defs/sha"},
        "head_sha": {"$ref": "#/$defs/sha"}
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inspection state bound to the receipt's single top-level target.",
      "required": ["cleanliness"],
      "properties": {
        "cleanliness": {"enum": ["clean", "dirty"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "location", "source_target", "blocks_pr", "disposition", "verification", "failure_pattern_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["Critical", "High", "Medium", "Low", "Informational"]},
        "location": {"type": "string", "minLength": 1},
        "source_target": {"$ref": "#/$defs/sha"},
        "blocks_pr": {"type": "boolean"},
        "disposition": {"enum": ["unresolved", "fixed", "accepted_risk", "deferred_with_owner", "not_valid"]},
        "verification": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "failure_pattern_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PQ-[0-9]{3}$"}
        }
      }
    }
  }
}
