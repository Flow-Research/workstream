# Copy this file to the ignored root .env and give every checkout a unique name
# and non-overlapping host ports. Replace every change-me value before startup.
COMPOSE_PROJECT_NAME=ws-pilot-local-change-me
LOCAL_UID=1000
LOCAL_GID=1000

WORKSTREAM_API_HOST_PORT=18000
WORKSTREAM_POSTGRES_HOST_PORT=15433
WORKSTREAM_REDIS_HOST_PORT=16379
WORKSTREAM_MINIO_API_HOST_PORT=19000
WORKSTREAM_MINIO_CONSOLE_HOST_PORT=19001

WORKSTREAM_POSTGRES_PASSWORD=change-me-postgres-password
WORKSTREAM_DATABASE_URL=postgresql+asyncpg://workstream:change-me-postgres-password@postgres:5432/workstream
WORKSTREAM_MINIO_ROOT_USER=change-me-minio-user
WORKSTREAM_MINIO_ROOT_PASSWORD=change-me-minio-password
WORKSTREAM_ARTIFACT_S3_BUCKET=workstream-local

WORKSTREAM_FLOW_AUTH_ISSUER=https://flow.local/pilot
WORKSTREAM_FLOW_AUTH_AUDIENCE=workstream-local-pilot
WORKSTREAM_FLOW_AUTH_LOCAL_HMAC_SECRET=change-me-flow-hmac-secret
# Canonical Base64 encodings of independent 32-byte values.
WORKSTREAM_API_RATE_LIMIT_KEY_SECRET=change-me-base64-32-byte-secret
WORKSTREAM_PAGINATION_CURSOR_HMAC_SECRET=change-me-base64-32-byte-secret

# A real provider key is required only for the genuine guide setup run.
OPENROUTER_API_KEY=
WORKSTREAM_PROJECT_AGENT_SDK_ENVIRONMENT=agents
WORKSTREAM_PROJECT_AGENT_RUNTIME=openai_agents_sdk
WORKSTREAM_PROJECT_AGENT_MODEL_PROVIDER=openrouter
WORKSTREAM_PROJECT_AGENT_MODEL_API=chat_completions
WORKSTREAM_PROJECT_AGENT_MODEL=openai/gpt-5.6-terra
WORKSTREAM_PROJECT_AGENT_RUNTIME_OPTIONS={}
WORKSTREAM_CELERY_WORKER_CONCURRENCY=2
# Required only when enabling the separate submission-intake worker profile.
# Supply a qualified positive value; no deployment default is selected.
WORKSTREAM_SUBMISSION_FINALIZATION_CONCURRENCY=
