# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

FROM rust:1.84.0-bookworm@sha256:e6e40c05cfe7dd55ad13794333d31b6d0818f0c6086876e7dc65871e6c8c0b21 AS builder

WORKDIR /workspace/external_checkers
COPY external_checkers/ ./
RUN cargo build --locked --release --jobs 2 --package workstream-checker-service

FROM docker:29.1.3-cli@sha256:4fa0ee1f3a7e4354c4ea34558b6d4ee32859baf4973d4c8ccc8e7fe3dd730c04 AS docker_cli

FROM python:3.12-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

ARG WORKSTREAM_RUNTIME_UID=10001
ARG WORKSTREAM_RUNTIME_GID=10001

RUN test "${WORKSTREAM_RUNTIME_UID}" -ne 0 \
    && test "${WORKSTREAM_RUNTIME_GID}" -ne 0 \
    && groupadd --gid "${WORKSTREAM_RUNTIME_GID}" workstream \
    && useradd --uid "${WORKSTREAM_RUNTIME_UID}" --gid workstream \
        --create-home --shell /usr/sbin/nologin workstream \
    && install -d -m 0700 -o workstream -g workstream \
        /var/lib/workstream/scratch /run/workstream-checker

COPY --from=builder \
    /workspace/external_checkers/target/release/workstream-checker-service \
    /usr/local/bin/workstream-checker-service
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker

RUN chmod 0555 /usr/local/bin/workstream-checker-service /usr/local/bin/docker

USER workstream

ENTRYPOINT ["/usr/local/bin/workstream-checker-service"]
CMD ["/etc/workstream/checker-service.json"]
