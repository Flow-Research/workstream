# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

FROM python:3.12-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

COPY --from=ghcr.io/astral-sh/uv:0.12.3@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc \
    /uv /uvx /bin/

ENV PATH="/opt/venv/bin:$PATH" \
    OPENSSL_armcap=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=120 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never

ARG WORKSTREAM_RUNTIME_UID=10001
ARG WORKSTREAM_RUNTIME_GID=10001

RUN test "${WORKSTREAM_RUNTIME_UID}" -ne 0 \
    && test "${WORKSTREAM_RUNTIME_GID}" -ne 0 \
    && groupadd --gid "${WORKSTREAM_RUNTIME_GID}" workstream \
    && useradd --uid "${WORKSTREAM_RUNTIME_UID}" --gid workstream \
        --create-home --shell /usr/sbin/nologin workstream \
    && install -d -m 0700 -o workstream -g workstream \
        /var/lib/workstream/scratch /run/workstream-checker

WORKDIR /workspace/backend

COPY backend/ ./
COPY docker/backend/release-entrypoint.sh /usr/local/bin/workstream-release-entrypoint

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra agents --no-dev --no-editable \
    && rm -rf /workspace/backend/build /workspace/backend/workstream_backend.egg-info \
    && chmod 0555 /usr/local/bin/workstream-release-entrypoint \
    && chown -R workstream:workstream /workspace /opt/venv

USER workstream

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/workstream-release-entrypoint"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
