# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

# Digest-pinned CPython runtime for Linux x86_64 and aarch64.
FROM python:3.12-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

COPY --from=ghcr.io/astral-sh/uv:0.12.3@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc \
    /uv /uvx /bin/

ENV PATH="/opt/venv/bin:$PATH" \
    OPENSSL_armcap=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=120 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never

ARG LOCAL_UID=1000
ARG LOCAL_GID=1000
ARG WORKSTREAM_PROJECT_AGENT_SDK_ENVIRONMENT

# Docker Desktop ARM VMs can advertise OpenSSL acceleration capabilities that
# still SIGILL when PyCA's bundled OpenSSL dispatches to them. The generic
# implementation is slower but deterministic and sufficient for local dev.

RUN if ! getent group "${LOCAL_GID}" >/dev/null; then \
        groupadd --gid "${LOCAL_GID}" workstream; \
    fi \
    && if [ "${LOCAL_UID}" -eq 0 ]; then \
        echo "LOCAL_UID=0 would run workstream as root" >&2; \
        exit 1; \
    fi \
    && useradd --non-unique --uid "${LOCAL_UID}" --gid "${LOCAL_GID}" --create-home --shell /bin/bash workstream

# The fixed guide parser owns this socket directory; workers only connect.
RUN install -d -m 0750 -o 10002 -g 10001 /var/lib/workstream/guide-runtime

WORKDIR /workspace/backend

RUN mkdir --parents /workspace/scratch \
    && chown --recursive "${LOCAL_UID}:${LOCAL_GID}" /workspace/scratch

COPY packages/external-services/ /workspace/packages/external-services/
COPY backend/ ./

# Install the committed resolution into a virtual environment outside the
# bind-mounted source tree using the committed dependency resolution.
RUN --mount=type=cache,target=/root/.cache/uv \
    case "${WORKSTREAM_PROJECT_AGENT_SDK_ENVIRONMENT}" in \
        agents|omnicore) ;; \
        *) echo "WORKSTREAM_PROJECT_AGENT_SDK_ENVIRONMENT must be agents or omnicore" >&2; exit 1 ;; \
    esac \
    && uv sync --locked --extra "${WORKSTREAM_PROJECT_AGENT_SDK_ENVIRONMENT}" --extra dev \
    && install -d -m 0755 /etc/workstream \
    && printf '%s\n' "${WORKSTREAM_PROJECT_AGENT_SDK_ENVIRONMENT}" \
        > /etc/workstream/project-agent-sdk-environment \
    && chmod 0444 /etc/workstream/project-agent-sdk-environment \
    && chown -R "${LOCAL_UID}:${LOCAL_GID}" /workspace /opt/venv

USER workstream

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
