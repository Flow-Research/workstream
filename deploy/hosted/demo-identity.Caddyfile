# Set DEMO_IDENTITY_HOSTNAME and DEMO_IDENTITY_UPSTREAM_CERT for the Caddy
# process. Its persistent data directory holds public HTTPS certificate state.
{
	admin off
	log {
		exclude http.log.error
	}
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 20s
			idle 30s
		}
		max_header_size 16KB
	}
}

(issuer_transport) {
	header_up -X-Forwarded-For
	header_up -X-Real-IP
	transport http {
		tls_server_name {$DEMO_IDENTITY_HOSTNAME}
		tls_trust_pool file {$DEMO_IDENTITY_UPSTREAM_CERT}
		dial_timeout 5s
		response_header_timeout 15s
		max_conns_per_host 16
		keepalive off
	}
}

{$DEMO_IDENTITY_HOSTNAME} {
	header Cache-Control no-store
	request_body {
		max_size 4KB
	}
	@jwks {
		method GET
		path /jwks.json
	}
	@accounts {
		method POST
		path /login /admin/accounts /me/password
	}
	route {
		reverse_proxy @jwks https://127.0.0.1:8443 {
			import issuer_transport
		}
		reverse_proxy @accounts https://127.0.0.1:8443 {
			import issuer_transport
		}
		respond 404
	}
}
