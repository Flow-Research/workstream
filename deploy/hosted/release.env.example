# Copy this non-secret template to a private operator file. Every image must be
# an immutable repository@sha256 reference produced from the reviewed source.
COMPOSE_PROJECT_NAME=workstream-release
WORKSTREAM_BACKEND_IMAGE=registry.example/workstream/backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WORKSTREAM_MODEL_PROXY_IMAGE=registry.example/workstream/backend-agents@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
WORKSTREAM_CHECKER_SERVICE_BINARY_SHA256=sha256:9999999999999999999999999999999999999999999999999999999999999999
WORKSTREAM_MODEL_PROXY_ENABLED=true

WORKSTREAM_DEPLOYMENT_ROOT=/var/lib/workstream
WORKSTREAM_CHECKER_SERVICE_BINARY=/opt/workstream/bin/workstream-checker-service
WORKSTREAM_RUNTIME_UID=10001
WORKSTREAM_RUNTIME_GID=10001
WORKSTREAM_API_HOST_PORT=8000
WORKSTREAM_CELERY_WORKER_CONCURRENCY=2

# These files contain one value each, are owned by the runtime UID/GID and use
# mode 0400. Preflight checks metadata and size without reading their contents.
WORKSTREAM_DATABASE_URL_FILE=/etc/workstream/secrets/database_url
WORKSTREAM_CELERY_BROKER_URL_FILE=/etc/workstream/secrets/celery_broker_url
WORKSTREAM_API_RATE_LIMIT_KEY_SECRET_FILE=/etc/workstream/secrets/api_rate_limit_key
WORKSTREAM_PAGINATION_CURSOR_HMAC_SECRET_FILE=/etc/workstream/secrets/pagination_cursor_hmac
# Nonempty paths select the matching provider overlay. The selected setup
# provider is required; the other provider is optional for approved POST
# profiles. Manager-authored setup requires at least one. Leave both blank when
# the proxy is disabled. This example selects OpenRouter only.
WORKSTREAM_MODEL_PROXY_OPENAI_API_KEY_FILE=
WORKSTREAM_MODEL_PROXY_OPENROUTER_API_KEY_FILE=/etc/workstream/secrets/model_proxy_openrouter_api_key

# The runtime, provider, model and bounded effective profile are public trusted
# configuration. Only the dedicated trusted model-proxy entrypoint maps each
# configured provider credential file to its native variable. The proxy
# image is always built with the pinned `agents` dependency set; workers may use
# either mutually exclusive project-agent SDK image and never receive the key.
WORKSTREAM_PROJECT_AGENT_RUNTIME=openai_agents_sdk
WORKSTREAM_PROJECT_AGENT_MODEL_PROVIDER=openrouter
WORKSTREAM_PROJECT_AGENT_MODEL=openai/gpt-5.6-terra
WORKSTREAM_PROJECT_AGENT_MODEL_API=chat_completions
WORKSTREAM_PROJECT_AGENT_RUNTIME_OPTIONS={}
WORKSTREAM_PROJECT_AGENT_RUN_TIMEOUT_SECONDS=1800
WORKSTREAM_PROJECT_AGENT_MAX_MANIFEST_BYTES=512000
WORKSTREAM_PROJECT_AGENT_MAX_DOCUMENTS=100
WORKSTREAM_PROJECT_AGENT_MAX_DOCUMENT_BYTES=67108864
WORKSTREAM_PROJECT_AGENT_MAX_TOTAL_DOCUMENT_BYTES=536870912
WORKSTREAM_PROJECT_AGENT_MAX_TURNS=40
WORKSTREAM_PROJECT_AGENT_MAX_TOOL_CALLS=80
WORKSTREAM_PROJECT_AGENT_MAX_TOOL_OUTPUT_CHARACTERS=4194304

WORKSTREAM_TOKEN_ISSUER=https://identity.example/flow
WORKSTREAM_TOKEN_AUDIENCE=workstream-api
WORKSTREAM_TOKEN_JWKS_URL=https://identity.example/flow/.well-known/jwks.json
WORKSTREAM_TOKEN_ALGORITHMS=RS256
WORKSTREAM_TOKEN_INTROSPECTION_MODE=disabled
WORKSTREAM_TOKEN_INTROSPECTION_DISABLED_REASON=Issuer policy does not expose token introspection.
WORKSTREAM_REQUIRED_HUMAN_SCOPE=workstream:access
WORKSTREAM_REQUIRED_SERVICE_SCOPE=workstream:service

WORKSTREAM_ARTIFACT_S3_REGION=us-east-1
WORKSTREAM_ARTIFACT_S3_BUCKET=replace-with-private-bucket
WORKSTREAM_ARTIFACT_S3_PRIVATE_PREFIX=workstream/artifacts
WORKSTREAM_ARTIFACT_S3_AWS_WORKLOAD_IDENTITY_METHOD=roles-anywhere

# These host paths identify the three separate leaf pairs. Preflight requires
# regular, nonempty, runtime-owned 0400 files. Long-lived services mount only
# the runtime pair; each proof job mounts only its own pair. Never place the
# CA signing key here. Keep it in the administrator-only CA directory.
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_RUNTIME_CERTIFICATE_HOST_FILE=/etc/workstream/roles-anywhere/runtime-certificate.pem
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_RUNTIME_PRIVATE_KEY_HOST_FILE=/etc/workstream/roles-anywhere/runtime-private-key.pem
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_READINESS_CERTIFICATE_HOST_FILE=/etc/workstream/roles-anywhere/readiness-certificate.pem
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_READINESS_PRIVATE_KEY_HOST_FILE=/etc/workstream/roles-anywhere/readiness-private-key.pem
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_NEGATIVE_CERTIFICATE_HOST_FILE=/etc/workstream/roles-anywhere/negative-certificate.pem
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_NEGATIVE_PRIVATE_KEY_HOST_FILE=/etc/workstream/roles-anywhere/negative-private-key.pem

# Bind every AWS-backed Settings process to one reviewed release and exact IAM
# evidence. These values are public identities/digests, not credentials. The
# canonical Settings owner validates digest shape, ARN partition/account scope,
# and distinct roles, trust policies and managed policies.
WORKSTREAM_RELEASE_ID=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
WORKSTREAM_ARTIFACT_S3_RUNTIME_ROLE_ARN=arn:aws:iam::123456789012:role/workstream-runtime
WORKSTREAM_ARTIFACT_S3_RUNTIME_TRUST_POLICY_SHA256=sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
WORKSTREAM_ARTIFACT_S3_RUNTIME_POLICY_ARN=arn:aws:iam::123456789012:policy/workstream-runtime
WORKSTREAM_ARTIFACT_S3_READINESS_ROLE_ARN=arn:aws:iam::123456789012:role/workstream-readiness
WORKSTREAM_ARTIFACT_S3_READINESS_TRUST_POLICY_SHA256=sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
WORKSTREAM_ARTIFACT_S3_READINESS_POLICY_ARN=arn:aws:iam::123456789012:policy/workstream-readiness
WORKSTREAM_ARTIFACT_S3_NEGATIVE_ROLE_ARN=arn:aws:iam::123456789012:role/workstream-negative
WORKSTREAM_ARTIFACT_S3_NEGATIVE_TRUST_POLICY_SHA256=sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
WORKSTREAM_ARTIFACT_S3_BOOTSTRAP_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/workstream-bootstrap
WORKSTREAM_ARTIFACT_S3_BUCKET_POLICY_SHA256=sha256:1111111111111111111111111111111111111111111111111111111111111111
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:123456789012:trust-anchor/00000000-0000-0000-0000-000000000001
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_TRUST_ANCHOR_SHA256=sha256:2222222222222222222222222222222222222222222222222222222222222222
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:123456789012:profile/00000000-0000-0000-0000-000000000002
WORKSTREAM_ARTIFACT_S3_ROLES_ANYWHERE_PROFILE_SHA256=sha256:3333333333333333333333333333333333333333333333333333333333333333

# These unmeasured starting values satisfy the proof-window envelope but are not
# live AWS latency evidence. Replace them with values supported by the hosted
# drill while retaining the envelope checked by the canonical Settings owner.
WORKSTREAM_ARTIFACT_S3_CONNECT_TIMEOUT_SECONDS=5
WORKSTREAM_ARTIFACT_S3_READ_TIMEOUT_SECONDS=60
WORKSTREAM_ARTIFACT_S3_WRITE_TIMEOUT_SECONDS=300
WORKSTREAM_ARTIFACT_S3_POOL_TIMEOUT_SECONDS=5
WORKSTREAM_ARTIFACT_S3_OPERATION_TOTAL_TIMEOUT_SECONDS=300
WORKSTREAM_ARTIFACT_COMPLETE_READ_DEADLINE_SECONDS=300
WORKSTREAM_ARTIFACT_TERMINAL_PERSISTENCE_MARGIN_SECONDS=120

# Existing ART processing deadline; keep ZIP inspection (300s) below it and
# deadline + cleanup margin (300s) below scratch reservation TTL (3900s).
# This operational setting does not change registered checker/project limits.
WORKSTREAM_ARTIFACT_PREPARATION_TOTAL_DEADLINE_SECONDS=3400

# The collector origin is optional. Production-like Settings require HTTPS.
WORKSTREAM_OBSERVABILITY_OTLP_ENDPOINT=
WORKSTREAM_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
WORKSTREAM_OBSERVABILITY_LOG_LEVEL=INFO

WORKSTREAM_CHECKER_CONFIG_FILE=/etc/workstream/checker-service.json

# Provision the trusted Smol intake node before launching API/Celery. Its private
# socket is /var/lib/workstream/checker-runtime/checker.sock, owned by 10001:10001.
# Replace both placeholders with identities verified from the built intake image.
WORKSTREAM_ARTIFACT_INTAKE_IMAGE_DIGEST=sha256:1111111111111111111111111111111111111111111111111111111111111111
WORKSTREAM_ARTIFACT_INTAKE_CONFIG_DIGEST=sha256:2222222222222222222222222222222222222222222222222222222222222222

# Optional only for approved POST trial selectors (requires the Smol trial runtime).
# Configure both here and pin the same host path/digest in the native service.
# Ordinary POST model calls do not require trial authority.
# WORKSTREAM_CHECKER_TRIAL_AUTHORITY_MANIFEST_PATH=/etc/workstream/trial-authority.json
# WORKSTREAM_CHECKER_TRIAL_AUTHORITY_MANIFEST_DIGEST=sha256:replace-with-canonical-manifest-digest
