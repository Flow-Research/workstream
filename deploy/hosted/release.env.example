# Copy this non-secret template to a private operator file. Every image must be
# an immutable repository@sha256 reference produced from the reviewed source.
COMPOSE_PROJECT_NAME=workstream-release
WORKSTREAM_BACKEND_IMAGE=registry.example/workstream/backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WORKSTREAM_CHECKER_SERVICE_IMAGE=registry.example/workstream/checker-service@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

WORKSTREAM_RUNTIME_UID=10001
WORKSTREAM_RUNTIME_GID=10001
WORKSTREAM_DOCKER_SOCKET_GID=999
WORKSTREAM_API_HOST_PORT=8000
WORKSTREAM_CELERY_WORKER_CONCURRENCY=2

# These files contain one value each, are owned by the runtime UID/GID and use
# mode 0400. Preflight checks metadata and size without reading their contents.
WORKSTREAM_DATABASE_URL_FILE=/etc/workstream/secrets/database_url
WORKSTREAM_CELERY_BROKER_URL_FILE=/etc/workstream/secrets/celery_broker_url
WORKSTREAM_API_RATE_LIMIT_KEY_SECRET_FILE=/etc/workstream/secrets/api_rate_limit_key
WORKSTREAM_PAGINATION_CURSOR_HMAC_SECRET_FILE=/etc/workstream/secrets/pagination_cursor_hmac
OPENAI_API_KEY_FILE=/etc/workstream/secrets/openai_api_key

WORKSTREAM_TOKEN_ISSUER=https://identity.example/flow
WORKSTREAM_TOKEN_AUDIENCE=workstream-api
WORKSTREAM_TOKEN_JWKS_URL=https://identity.example/flow/.well-known/jwks.json
WORKSTREAM_TOKEN_ALGORITHMS=RS256
WORKSTREAM_TOKEN_INTROSPECTION_MODE=disabled
WORKSTREAM_TOKEN_INTROSPECTION_DISABLED_REASON=Issuer policy does not expose token introspection.
WORKSTREAM_REQUIRED_HUMAN_SCOPE=workstream:access
WORKSTREAM_REQUIRED_SERVICE_SCOPE=workstream:service

WORKSTREAM_ARTIFACT_S3_REGION=us-east-1
WORKSTREAM_ARTIFACT_S3_BUCKET=replace-with-private-bucket
WORKSTREAM_ARTIFACT_S3_PRIVATE_PREFIX=workstream/artifacts
WORKSTREAM_ARTIFACT_S3_AWS_WORKLOAD_IDENTITY_METHOD=iam-role

# Bind every AWS-backed Settings process to one reviewed release and exact IAM
# evidence. These values are public identities/digests, not credentials. The
# canonical Settings owner validates digest shape, ARN partition/account scope,
# and distinct roles, trust policies and managed policies.
WORKSTREAM_RELEASE_ID=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
WORKSTREAM_ARTIFACT_S3_RUNTIME_ROLE_ARN=arn:aws:iam::123456789012:role/workstream-runtime
WORKSTREAM_ARTIFACT_S3_RUNTIME_TRUST_POLICY_SHA256=sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
WORKSTREAM_ARTIFACT_S3_RUNTIME_POLICY_ARN=arn:aws:iam::123456789012:policy/workstream-runtime
WORKSTREAM_ARTIFACT_S3_READINESS_ROLE_ARN=arn:aws:iam::123456789012:role/workstream-readiness
WORKSTREAM_ARTIFACT_S3_READINESS_TRUST_POLICY_SHA256=sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
WORKSTREAM_ARTIFACT_S3_READINESS_POLICY_ARN=arn:aws:iam::123456789012:policy/workstream-readiness
WORKSTREAM_ARTIFACT_S3_NEGATIVE_ROLE_ARN=arn:aws:iam::123456789012:role/workstream-negative
WORKSTREAM_ARTIFACT_S3_NEGATIVE_TRUST_POLICY_SHA256=sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
WORKSTREAM_ARTIFACT_S3_BOOTSTRAP_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/workstream-bootstrap
WORKSTREAM_ARTIFACT_S3_BUCKET_POLICY_SHA256=sha256:1111111111111111111111111111111111111111111111111111111111111111

# These unmeasured starting values satisfy the proof-window envelope but are not
# live AWS latency evidence. Replace them with values supported by the hosted
# drill while retaining the envelope checked by the canonical Settings owner.
WORKSTREAM_ARTIFACT_S3_CONNECT_TIMEOUT_SECONDS=5
WORKSTREAM_ARTIFACT_S3_READ_TIMEOUT_SECONDS=60
WORKSTREAM_ARTIFACT_S3_WRITE_TIMEOUT_SECONDS=300
WORKSTREAM_ARTIFACT_S3_POOL_TIMEOUT_SECONDS=5
WORKSTREAM_ARTIFACT_S3_OPERATION_TOTAL_TIMEOUT_SECONDS=300
WORKSTREAM_ARTIFACT_COMPLETE_READ_DEADLINE_SECONDS=300
WORKSTREAM_ARTIFACT_TERMINAL_PERSISTENCE_MARGIN_SECONDS=120

# The collector origin is optional. Production-like Settings require HTTPS.
WORKSTREAM_OBSERVABILITY_OTLP_ENDPOINT=
WORKSTREAM_OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
WORKSTREAM_OBSERVABILITY_LOG_LEVEL=INFO

WORKSTREAM_CHECKER_CONFIG_FILE=/etc/workstream/checker-service.json
