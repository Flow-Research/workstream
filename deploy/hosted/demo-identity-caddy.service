[Unit]
Description=Flow demo identity HTTPS ingress
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=workstream-identity-ingress
Group=workstream-identity-ingress
EnvironmentFile=/etc/workstream-identity-ingress/ingress.env
ExecStartPre=/usr/local/libexec/workstream-identity-ingress/caddy validate --config /etc/workstream-identity-ingress/Caddyfile --adapter caddyfile
ExecStart=/usr/local/libexec/workstream-identity-ingress/caddy run --config /etc/workstream-identity-ingress/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/workstream-identity-ingress
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=256M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
