# Public native-client ingress. Keep API, MCP and issuer listeners loopback-only.
# Configure the four variables described in PUBLIC_ACCESS.md in the existing
# ingress service's private environment file. Preserve its persistent TLS state.
{
	admin off
	log {
		exclude http.log.error
	}
	servers {
		timeouts {
			read_header 10s
			read_body 600s
			write 4200s
			idle 30s
		}
		max_header_size 16KB
	}
}

(issuer_transport) {
	header_up -X-Forwarded-For
	header_up -X-Real-IP
	header_up -Forwarded
	transport http {
		tls_server_name {$DEMO_IDENTITY_HOSTNAME}
		tls_trust_pool file {$DEMO_IDENTITY_UPSTREAM_CERT}
		dial_timeout 5s
		response_header_timeout 15s
		max_conns_per_host 16
		keepalive off
	}
}

{$DEMO_IDENTITY_HOSTNAME} {
	header Cache-Control no-store
	request_body {
		max_size 4KiB
	}
	@jwks {
		method GET
		path /jwks.json
	}
	@accounts {
		method POST
		path /login /admin/accounts /me/password
	}
	route {
		reverse_proxy @jwks https://127.0.0.1:8443 {
			import issuer_transport
		}
		reverse_proxy @accounts https://127.0.0.1:8443 {
			import issuer_transport
		}
		respond 404
	}
}

{$WORKSTREAM_PUBLIC_HOSTNAME} {
	header Cache-Control no-store
	route {
		handle /mcp {
			# JSON/base64 tools retain the MCP owner's stricter body/deadline limits.
			request_body {
				max_size 96MiB
			}
			reverse_proxy 127.0.0.1:8080 {
				header_up Host 127.0.0.1:8080
				header_up -X-Forwarded-For
				header_up -X-Real-IP
				header_up -Forwarded
				# Do not strip Origin: MCP rejects browser requests itself.
				flush_interval -1
				transport http {
					dial_timeout 5s
					response_header_timeout 180s
					max_conns_per_host 16
				}
			}
		}
		handle /api/* {
			# Binary ZIP upload is streamed, never buffered by this proxy.
			request_body {
				max_size 500MiB
			}
			reverse_proxy 127.0.0.1:{$WORKSTREAM_API_HOST_PORT} {
				header_up -X-Forwarded-For
				header_up -X-Real-IP
				header_up -Forwarded
				transport http {
					dial_timeout 5s
					response_header_timeout 3600s
					max_conns_per_host 32
				}
			}
		}
		respond 404
	}
}

# A valid TLS SNI with a substituted HTTP Host must not route to an upstream.
:443 {
	respond 404
}
