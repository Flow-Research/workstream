      "PolicyUpdateInput": {
        "additionalProperties": false,
        "allOf": [
          {
            "properties": {
              "rules": {
                "contains": {
                  "properties": {
                    "contribution_type": {
                      "const": "accepted_submission"
                    }
                  },
