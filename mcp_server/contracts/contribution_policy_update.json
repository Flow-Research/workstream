                  },
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,31}$",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "instrument_type": {
                  "const": "money"
                }
              }
            },
            "then": {
              "properties": {
                "unit_code": {
                  "not": {
                    "pattern": "[^A-Z]"
                  },
                  "pattern": "^[A-Z]{3}$",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "instrument_type": {
                  "const": "project_points"
                }
              }
            },
            "then": {
              "properties": {
                "rules": {
                  "items": {
                    "properties": {
                      "quantities": {
                        "properties": {
                          "large": {
                            "not": {
                              "pattern": "[^0-9]"
                            },
                            "pattern": "^[1-9][0-9]{0,19}$"
                          },
                          "medium": {
                            "not": {
                              "pattern": "[^0-9]"
                            },
                            "pattern": "^[1-9][0-9]{0,19}$"
                          },
