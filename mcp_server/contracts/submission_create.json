          "registry_entry_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Registry Entry Digest",
            "type": "string"
          },
          "registry_entry_id": {
            "format": "uuid",
            "title": "Registry Entry Id",
            "type": "string"
          },
          "requirement_id": {
            "maxLength": 100,
            "minLength": 1,
