      "ExternalCheckerFinding": {
        "additionalProperties": false,
        "description": "Sanitized work result; policy later decides whether failure blocks.\n\n``coverage_incomplete`` reports work the checker could not evaluate. It never\nfails the verdict or costs a revision round; locked ReviewPolicy routing sends\nit to a reviewer or back to the contributor.",
        "properties": {
          "check_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "title": "Check Id",
            "type": "string"
          },
          "code": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "title": "Code",
            "type": "string"
          },
          "level": {
            "enum": [
              "info",
              "warning",
              "error",
              "coverage_incomplete"
            ],
            "title": "Level",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "maximum": 10000000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "message": {
            "description": "Contributor-visible diagnosis, including useful correction guidance when available.",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
