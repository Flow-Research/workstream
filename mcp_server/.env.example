WORKSTREAM_API_URL=https://workstream.flowresearch.tech
WORKSTREAM_MCP_TOKEN_ISSUER=https://identity.flowresearch.tech/realms/flow
WORKSTREAM_MCP_RESOURCE_URL=https://workstream.flowresearch.tech/mcp
WORKSTREAM_MCP_EXCHANGE_CLIENT_ID=workstream-mcp
WORKSTREAM_MCP_API_AUDIENCE=workstream-api
# Mount a private file containing the confidential MCP client's secret; never a user token.
WORKSTREAM_MCP_EXCHANGE_SECRET_FILE=/run/secrets/mcp-exchange-secret
WORKSTREAM_MCP_HOST=127.0.0.1
WORKSTREAM_MCP_PORT=8080
WORKSTREAM_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
WORKSTREAM_MCP_MAX_REQUEST_BYTES=100663296
WORKSTREAM_MCP_MAX_RESPONSE_BYTES=65536
WORKSTREAM_MCP_MAX_DOCUMENT_BYTES=67108864
WORKSTREAM_MCP_MAX_HEADER_BYTES=16384
WORKSTREAM_MCP_MAX_REQUEST_FRAMES=128
WORKSTREAM_MCP_MAX_IN_FLIGHT=8
WORKSTREAM_MCP_INGRESS_TIMEOUT_SECONDS=15
WORKSTREAM_MCP_CONNECT_TIMEOUT_SECONDS=3
WORKSTREAM_MCP_READ_TIMEOUT_SECONDS=10
WORKSTREAM_MCP_TOTAL_TIMEOUT_SECONDS=12
WORKSTREAM_MCP_DOCUMENT_TIMEOUT_SECONDS=120
WORKSTREAM_MCP_KEEP_ALIVE_SECONDS=5
